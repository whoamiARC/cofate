{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yuzero-causality",
  "workers_dev": true,
  "preview_urls": false,
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "./dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yuzero-causality-db",
      "database_id": "39218e87-2697-41d6-a028-2fac21bb5ac0",
      "migrations_dir": "./drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
