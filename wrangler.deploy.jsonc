{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cofate",
  "workers_dev": true,
  "preview_urls": false,
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "./dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cofate-db",
      "database_id": "089c9df5-3780-4891-8ce8-d7f185d9fda0",
      "migrations_dir": "./drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
